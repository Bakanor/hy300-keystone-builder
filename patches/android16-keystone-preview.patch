diff --git a/libs/renderengine/include/renderengine/KeystoneTransform.h b/libs/renderengine/include/renderengine/KeystoneTransform.h
new file mode 100644
--- /dev/null
+++ b/libs/renderengine/include/renderengine/KeystoneTransform.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <optional>
+
+namespace hy300 {
+
+struct Point {
+    double x;
+    double y;
+};
+
+// Coordinates are top-left origin and normalized to the panel dimensions.
+// The stock Parcel encodes inward offsets in BL, TL, TR, BR order.
+using Corners = std::array<Point, 4>;
+using Matrix = std::array<double, 9>;
+
+inline Corners fromStockOffsets(const Corners& offsets) {
+    return {{{offsets[1].x, offsets[1].y},
+             {1 - offsets[2].x, offsets[2].y},
+             {1 - offsets[3].x, 1 - offsets[3].y},
+             {offsets[0].x, 1 - offsets[0].y}}};
+}
+
+inline std::optional<Matrix> projection(const Corners& corners) {
+    constexpr double epsilon = 1e-8;
+    for (std::size_t i = 0; i < corners.size(); ++i) {
+        const auto& a = corners[i];
+        const auto& b = corners[(i + 1) % 4];
+        const auto& c = corners[(i + 2) % 4];
+        const double cross = (b.x - a.x) * (c.y - b.y) - (b.y - a.y) * (c.x - b.x);
+        if (!(a.x >= 0 && a.x <= 1 && a.y >= 0 && a.y <= 1 && cross > epsilon)) {
+            return std::nullopt;
+        }
+    }
+
+    const auto& [a, b, c, d] = corners;
+    const double dx1 = b.x - c.x;
+    const double dx2 = d.x - c.x;
+    const double dy1 = b.y - c.y;
+    const double dy2 = d.y - c.y;
+    const double sx = a.x - b.x + c.x - d.x;
+    const double sy = a.y - b.y + c.y - d.y;
+    const double determinant = dx1 * dy2 - dx2 * dy1;
+    if (std::abs(determinant) <= epsilon) return std::nullopt;
+
+    const double g = (sx * dy2 - dx2 * sy) / determinant;
+    const double h = (dx1 * sy - sx * dy1) / determinant;
+    return Matrix{b.x - a.x + g * b.x, d.x - a.x + h * d.x, a.x,
+                  b.y - a.y + g * b.y, d.y - a.y + h * d.y, a.y,
+                  g, h, 1};
+}
+
+} // namespace hy300
